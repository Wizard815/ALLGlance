# Add these to omi-host/.env on the machine that runs Omi (wizard815/omi-local), then
# `docker compose up -d` there. Values marked <...> come from ALLGlance's .env.allglance;
# scripts/setup.sh prints them ready to paste.
#
# Omi runs as its own compose project, so use the host's address, not a container name.

# The gateway: Omi's chat gets allglance_* tools, new action items land in Vikunja,
# and heard events can be added to the family calendar after you review them
# (Omi app -> Settings -> Family calendar).
ALLGLANCE_URL=http://<allglance-host>:8090
ALLGLANCE_TOKEN=<GATEWAY_TOKEN from .env.allglance>

# Tasks both ways over CalDAV. Use the Vikunja login setup.sh printed
# (VIKUNJA_BOOTSTRAP_USER / VIKUNJA_BOOTSTRAP_PASSWORD) or a Vikunja CalDAV token.
CALDAV_DEFAULT_URL=http://<allglance-host>:8090/dav/
CALDAV_USER=<vikunja user>
CALDAV_PASSWORD=<vikunja password>

# The other direction (Omi's day summary and memories inside the gateway) is set on the
# ALLGlance side, in .env.allglance:
#   OMI_URL=http://<omi-host>:8000
#   OMI_MCP_TOKEN=omi_mcp_...     # Omi app -> Settings -> Developer -> MCP -> Create Key
