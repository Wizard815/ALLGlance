{
  "name": "@allglance/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AllGLANCE gateway — one MCP server + REST gateway exposing task, calendar, chore, and milestone data across vikunja, dayGLANCE, lastGLANCE, and lifeGLANCE, with per-user ownership scoping.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-reporter spec",
    "lint": "eslint src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "playwright": "^1.49.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.18.0",
    "globals": "^16"
  },
  "license": "MIT"
}
