# AllGLANCE gateway configuration.
#
# Copy to .env.allglance at the repo root (as the README documents) and edit:
#   cp gateway/.env.example ../.env.allglance     # or wherever docker-compose.yml expects it
#
# Every variable has a default in src/config.js. The defaults target the
# standard docker-compose network where each service is reachable by its
# compose service name. On Unraid you typically only need to set
# VIKUNJA_TOKEN and optionally disable adapters you don't run.

# --- Gateway HTTP server ---
# Host/port the gateway binds to. 0.0.0.0 exposes it on the container network;
# 127.0.0.1 restricts it to the container loopback (reverse-proxy it yourself).
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8090

# --- vikunja (the only app with a real server) ---
# REST API base URL. Use the compose service name for intra-network access.
VIKUNJA_URL=http://vikunja:3456
# API token for vikunja. Generate one in vikunja (Account → Access Tokens),
# or use a token for the `admin` account. Leave empty to disable writes.
VIKUNJA_TOKEN=
# Optional CalDAV base URL, e.g. for syncing dayglance blocks to/from vikunja.
VIKUNJA_CALDAV_URL=
# Toggle the vikunja adapter.
ENABLE_VIKUNJA=true

# --- dayglance (family roster owner) ---
# Host of dayglance's MCP listener. In the container stack this is the
# dayglance-mcp service (see docker-compose.yml); for the desktop app it is
# 127.0.0.1. The gateway connects to http://<host>:<port>/mcp.
DAYGLANCE_MCP_HOST=dayglance-mcp
# Port of dayglance's MCP listener.
DAYGLANCE_MCP_PORT=7893
# Bearer token for dayglance's MCP listener. The dayglance-mcp service and this
# gateway must share the SAME value. Leave empty only on a fully private
# network (the container then accepts unauthenticated MCP calls).
DAYGLANCE_MCP_TOKEN=
# Docker web build base URL. NOTE: the web build keeps data in the VISITING
# browser's localStorage; server-side dayglance reads come from the dayglance-mcp
# service's state document, not from this URL.
DAYGLANCE_WEB_URL=http://dayglance:80
# Toggle the dayglance adapter.
ENABLE_DAYGLANCE=true

# --- lastglance (chores) ---
LASTGLANCE_WEB_URL=http://lastglance:80
ENABLE_LASTGLANCE=true

# --- lifeglance (milestones) ---
LIFELANCE_WEB_URL=http://lifeglance:80
ENABLE_LIFELANCE=true

# --- GLANCEvault (zero-knowledge sync backbone) ---
# The vault is the shared backend the three browser apps sync their encrypted
# rows to. The gateway can act as a vault client: fetch per-app rows and
# decrypt them with the household sync passphrase, so one MCP can serve data
# that lives only in the browser apps.
#
# Set these on the glance-vault CONTAINER too (they configure the server):
#   GLANCEVAULT_DEVICE_TOKEN  - the server's shared device token (required)
#   GLANCEVAULT_AUTH_MODE     - 'shared' (default) or 'per-account'
#   GLANCEVAULT_ALLOWED_ORIGINS - comma-separated browser origins, e.g.
#                                 app://dayglance,https://dayglance.example.com
#
# And these on the GATEWAY to read from it:
GLANCEVAULT_URL=http://glance-vault:8080
# Same device token the vault server uses. Required for the gateway to read.
GLANCEVAULT_DEVICE_TOKEN=
# Account id when the vault runs in per-account mode (blank in shared mode).
GLANCEVAULT_ACCOUNT=
# The household sync passphrase. The gateway derives the decryption key from it
# (deriveIntentsRootKey) to read the apps' encrypted rows. SECRET — treat like
# every other credential here. Without it the vault rows stay opaque.
GLANCEVAULT_PASSPHRASE=
# Toggle the vault-backed source for the browser apps.
ENABLE_GLANCEVAULT=true

# --- Playwright (localStorage fallback reader for the three web-build apps) ---
# Launch headless chromium. Set to 0 to keep the browser window visible when
# debugging localStorage reads (headless is slower on first launch).
PLAYWRIGHT_HEADLESS=true
# Per-read timeout in milliseconds. Web builds are heavy SPAs; give them room.
PLAYWRIGHT_TIMEOUT_MS=30000
